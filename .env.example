# Client env. Set these in local `.env.local`, AIT, and Vercel if Vercel hosts the web app.
VITE_API_BASE=
VITE_AUTH_ENABLED=true
VITE_SUPABASE_URL=https://xiyrggeyckhmxpkesswj.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_AD_BANNER_UNIT_ID=ait.v2.live.40145900ff404573
VITE_AD_REWARD_UNIT_ID=ait.v2.live.cf2b6c321a3f4d33
VITE_IAP_AI_CHARACTER_SKU=
VITE_IAP_AI_CHARACTER_PACK_SKU=
VITE_TOSS_LOGIN_CLIENT_ID=

# Vercel serverless env only. Do not expose these as VITE_* values or register them in client-only AIT env.
SUPABASE_SERVICE_ROLE_KEY=
TOSS_DECRYPT_KEY=
TOSS_DECRYPT_AAD=TOSS
# Optional only if Toss Login is wired through OAuth code exchange instead of the AIT encrypted user payload.
TOSS_LOGIN_CLIENT_SECRET=
# Prefer these in Vercel because serverless functions cannot rely on local cert files.
TOSS_MTLS_CERT_BASE64=
TOSS_MTLS_KEY_BASE64=
# Local fallback for development or a server runtime with cert files mounted.
MTLS_CERT_PATH=server/certs/savewithpet_public.crt
MTLS_KEY_PATH=server/certs/savewithpet_private.key
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
AI_CHARACTER_GENERATION_ENABLED=false
